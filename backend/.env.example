# ─────────────────────────────────────────────────────────
# Kutumb Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# Server
PORT=5001
NODE_ENV=development  # set to 'production' when deploying

# Database (PostgreSQL)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=family_tree
DB_PORT=5432

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars

# CORS — comma-separated list of allowed frontend origins
# Example for production: https://kutumb.ai,https://www.kutumb.ai
ALLOWED_ORIGINS=http://localhost:3000

# Used to build password-reset links emailed to users (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Gmail SMTP — for sending password-reset emails. Generate an App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password

# Cloudinary — for storing person photos. Free account at
# https://cloudinary.com/users/register/free — all 3 values shown on your
# dashboard immediately after signup, no extra config needed.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
