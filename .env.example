# ─────────────────────────────────────────────────────────
# Docker Compose environment overrides
# Copy this file to .env (same directory as docker-compose.yml) and fill in
# real values before running `docker-compose up`.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars

# Gmail SMTP — for sending password-reset emails. Generate an App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Optional: leave blank to run without email (password reset will just no-op
# instead of sending anything).
SMTP_USER=
SMTP_PASS=

# Cloudinary — for storing person photos. Free account at
# https://cloudinary.com/users/register/free — all 3 values shown on your
# dashboard immediately after signup, no extra config needed.
# Optional: leave blank to run without photo uploads working.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
